@mode(host.scripted)

# cronnext's schedules: the five fields together, the macros, cron's rule
# for the two day fields, and the search for the next run.
#
# Runtime: host.scripted. A module of the script bin/cronnext.lpscr,
# interpreted with it by `loup run`; tests/schedule_test.lpscr imports it
# under Stage0's test runner.

from core.string_utils import (splitWhitespace);
from .field import (FieldKind, Field, parse_field);
from .clock import (Civil, civil, minute_at, start_of_next_day, start_of_next_hour, start_of_next_month, MINUTES_PER_DAY);

pub struct Schedule {
    # The five fields with single spaces (`*/15 9-17 * * mon-fri`), or the
    # macro as written (`@daily`).
    pub text: string;
    pub minute: Field;
    pub hour: Field;
    pub day: Field;
    pub month: Field;
    pub weekday: Field;
}

# The macros of Vixie cron and cronie. @reboot has no times and is handled
# by the caller.
let MACROS: dict[string, string] = {
    "@yearly": "0 0 1 1 *",
    "@annually": "0 0 1 1 *",
    "@monthly": "0 0 1 * *",
    "@weekly": "0 0 * * 0",
    "@daily": "0 0 * * *",
    "@midnight": "0 0 * * *",
    "@hourly": "0 * * * *",
};

# The five fields a macro stands for.
pub func macro_fields(word: string): Option[string] {
    return MACROS.get(word.toLowerCase());
}

pub func parse_schedule(text: string): Result[Schedule, string] {
    let written = text.trim();
    var expression = written;
    if (written.startsWith("@")) {
        if (written.toLowerCase() == "@reboot") {
            return Err("@reboot runs only when cron starts");
        }
        expression = match macro_fields(written) {
            Some(fields) => fields,
            None => { return Err(i"unknown macro '{$ written $}'"); },
        };
    }
    let words = splitWhitespace(expression);
    if (words.len() != 5) {
        return Err(i"expected 5 fields, found {$ words.len() $} in '{$ written $}'");
    }
    return Ok(Schedule(
        text = if (written.startsWith("@")) { written } else { words.join(" ") },
        minute = parse_field(FieldKind.Minute, words[0])?,
        hour = parse_field(FieldKind.Hour, words[1])?,
        day = parse_field(FieldKind.DayOfMonth, words[2])?,
        month = parse_field(FieldKind.Month, words[3])?,
        weekday = parse_field(FieldKind.DayOfWeek, words[4])?,
    ));
}

# Cron's day rule: when both day fields are restricted, a day matches if
# either does ("on the 1st or on Mondays"); when one is `*` (or starts
# with `*`), both must match, which leaves the other one deciding.
pub func day_matches(s: Schedule, day: int, weekday: int): bool {
    let by_date = s.day.allowed.contains(day);
    let by_weekday = s.weekday.allowed.contains(weekday);
    return match (s.day.restricted, s.weekday.restricted) {
        (true, true) => by_date or by_weekday,
        _ => by_date and by_weekday,
    };
}

# Whether the schedule runs at minute `at`.
pub func runs_at(s: Schedule, at: int): bool {
    let c = civil(at);
    return s.minute.allowed.contains(c.minute) and s.hour.allowed.contains(c.hour)
        and s.month.allowed.contains(c.month) and day_matches(s, c.day, c.weekday);
}

# The first of the ascending `values` that is at least `least`.
func first_at_least(values: list[int], least: int): Option[int] {
    for (v in values) {
        if (v >= least) {
            return Some(v);
        }
    }
    return None;
}

# The first minute at or after `start` and before `limit` when the
# schedule runs. Instead of testing every minute, each step jumps to the
# start of the next month, day or hour that can match, so a search costs
# about one step per day it passes.
pub func next_run(s: Schedule, start: int, limit: int): Option[int] {
    var at = start;
    while (at < limit) {
        let c: Civil = civil(at);
        if (!s.month.allowed.contains(c.month)) {
            at = start_of_next_month(c);
            continue;
        }
        if (!day_matches(s, c.day, c.weekday)) {
            at = start_of_next_day(at);
            continue;
        }
        match first_at_least(s.hour.values, c.hour) {
            None => {
                at = start_of_next_day(at);
                continue;
            },
            Some(h) if (h > c.hour) => {
                at = minute_at(c.year, c.month, c.day, h, 0);
                continue;
            },
            Some(_) => {},
        }
        match first_at_least(s.minute.values, c.minute) {
            None => { at = start_of_next_hour(at); },
            Some(m) => {
                let found = at + (m - c.minute);
                return if (found < limit) { Some(found) } else { None };
            },
        }
    }
    return None;
}

# Cron schedules repeat within 28 years (the calendar's cycle of weekdays
# and leap years, short of the century rule), so a schedule with no run in
# that time never runs: `0 0 30 2 *`.
# 28 years of 366 days, in minutes.
pub const HORIZON: int = 14_757_120;

# The first `count` runs at or after `start` and before `limit`.
pub func runs_of(s: Schedule, start: int, limit: int, count: int): list[int] {
    var runs: list[int] = [];
    var at = start;
    while (runs.len() < count) {
        match next_run(s, at, limit) {
            Some(t) => {
                runs.push(t);
                at = t + 1;
            },
            None => { break; },
        }
    }
    return runs;
}
